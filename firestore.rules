rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. 최고 관리자 (admin) 확인
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == '520stevekim@gmail.com' ||
        request.auth.token.email.matches('^admin.*')
      );
    }

    // 3. 학생회 임원 또는 교직원, 관리자 (staff) 확인
    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['council', 'teacher', 'admin'])
      );
    }

    // 4. 사용자 프로필 컬렉션 (/users/{userId})
    match /users/{userId} {
      // 로그인한 유저는 사용자 목록 및 프로필 조회 가능
      allow read: if isAuthenticated();

      // 신규 등록: 본인 계정 생성 허용
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // 수정: 관리자는 모든 유저 수정 가능, 일반 유저는 본인의 프로필(이름/학번/학년 등)만 수정 가능 (role 수정은 관리자만)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])))
      );

      // 삭제: 최고 관리자만 가능
      allow delete: if isAdmin();
    }

    // 5. 청원 데이터 문서 (/petitions/{petitionId})
    match /petitions/{petitionId} {
      // 모든 사용자가 청원 목록 및 상세 내용 조회 가능
      allow read: if true;
      
      // 로그인한 학생이 청원 생성 가능
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      
      // 동의 투표(agreeCount 증가) 또는 학생회/관리자 공식 검토 및 답변 등록
      allow update: if isAuthenticated();
      
      // 삭제는 관리자만 가능
      allow delete: if isAdmin();

      // 1인 1동의 서브컬렉션 (/petitions/{petitionId}/agreements/{userId})
      match /agreements/{userId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
  }
}
