rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 관리자 여부 확인 (users 컬렉션 role 확인 또는 지정된 관리자 이메일)
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == '520stevekim@gmail.com' ||
        request.auth.token.email.matches('^admin.*')
      );
    }

    // 사용자 정보 문서 규칙
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 청원 데이터 문서 규칙
    match /petitions/{petitionId} {
      // 모든 사용자가 청원 목록 및 상세 내용 조회 가능
      allow read: if true;
      
      // 로그인한 사용자가 청원 생성 가능
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      
      // 동의 투표(agreeCount 증가) 및 관리자 심사(승인/반려/답변 등록) 수정 허용
      allow update: if isAuthenticated();
      
      // 삭제는 관리자만 가능
      allow delete: if isAdmin();

      // 1인 1동의 서브컬렉션 규칙
      match /agreements/{userId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
  }
}
